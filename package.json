{
  "name": "cca-message-ai",
  "private": true,
  "description": "Extensión de Chrome para mejorar mensajes de WhatsApp Web con IA local.",
  "author": "CCA Soluciones Web <https://ccasolucionesweb.com/>",
  "homepage": "https://texvnonline.github.io/cca-message-ai/",
  "repository": "https://github.com/TexvnOnline/cca-message-ai",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test tests/e2e-playwright/whatsapp-integration.spec.js",
    "test:e2e:provider": "playwright test tests/e2e-playwright/provider-contract.spec.js",
    "test:e2e:popup": "playwright test tests/e2e-playwright/popup-model-loading.spec.js",
    "test:e2e:all": "playwright test tests/e2e-playwright/whatsapp-integration.spec.js tests/e2e-playwright/whatsapp-extension.spec.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "build:clean": "node -e \"for (const p of ['dist','web-ext-artifacts','cca-message-ai-chrome.zip','cca-message-ai-firefox.xpi']) require('fs').rmSync(p,{recursive:true,force:true})\"",
    "build:release": "npm run build:release:chrome && npm run build:release:firefox",
    "build:release:chrome": "node scripts/build-release.mjs --target=chrome",
    "build:release:firefox": "node scripts/build-release.mjs --target=firefox"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.60.0",
    "@vitest/ui": "4.1.7",
    "esbuild": "0.27.0",
    "happy-dom": "20.9.0",
    "html-minifier-terser": "7.2.0",
    "playwright": "^1.60.0",
    "vitest": "4.1.7"
  }
}
